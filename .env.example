# Copy to .env.local for local work; set the same keys in Hostinger hPanel for production.

# Brand name shown across the site
SITE_NAME=NutriVerdict

# Primary domain, no trailing slash. Only this host is indexable in production.
SITE_URL=https://www.yourdomain.com

# Indexing lifecycle: development | soft-launch | production
#  development / soft-launch → noindex,nofollow everywhere
#  production                → indexable, sitemap linked from robots.txt
SITE_STAGE=development

# Affiliate IDs (leave empty until approved)
AMAZON_TAG=
IHERB_RCODE=
