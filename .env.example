# Copy to .env.local for local work; set the same keys in Hostinger hPanel for production.

# Brand name shown across the site
SITE_NAME=GuruHealthline

# Primary domain, no trailing slash. Only this host is indexable in production.
SITE_URL=https://guruhealthline.com

# Indexing lifecycle: development | soft-launch | production
#  development / soft-launch → noindex,nofollow everywhere
#  production                → indexable, sitemap linked from robots.txt
SITE_STAGE=development

# Affiliate IDs (leave empty until approved)
AMAZON_TAG=
IHERB_RCODE=

# ── Shop ────────────────────────────────────────────────────────────────
# MySQL database (hPanel → Databases → MySQL). Tables are created automatically.
# Format: mysql://USER:PASSWORD@HOST:3306/DATABASE
DATABASE_URL=

# Shipping (USD): flat rate below the threshold, free at or above it
SHIPPING_FLAT_USD=5.95
FREE_SHIPPING_FROM_USD=50

# Stripe (Dashboard → Developers → API keys). Start with sk_test_… keys.
STRIPE_SECRET_KEY=
# Webhook endpoint: https://guruhealthline.com/api/webhooks/stripe/
# Events: checkout.session.completed, checkout.session.async_payment_succeeded, charge.refunded
STRIPE_WEBHOOK_SECRET=
# true only after Stripe Tax is activated in the Stripe Dashboard
STRIPE_AUTOMATIC_TAX=false

# PayPal (developer.paypal.com → Apps & Credentials). sandbox | live
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Supliful fulfillment through a headless Shopify store (optional; without it
# orders are emailed to you for manual handling).
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_TOKEN=
# Webhook endpoint: https://guruhealthline.com/api/webhooks/shopify/
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_API_VERSION=2025-07

# Order emails through Hostinger email (SMTP)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=orders@guruhealthline.com
SMTP_PASS=
MAIL_FROM=orders@guruhealthline.com
ORDER_NOTIFY_EMAIL=

# Admin at /admin/ (password: 12+ characters; secret: any long random string)
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
